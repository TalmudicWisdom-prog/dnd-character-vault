    {
      "id": "ffxiv-companion-dawntrail:stone",
      "name": "Stone",
      "level": 0,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "1d8",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjure a cluster of aetheric stones and fires them toward a creature within range. Make a ranged spell attack against the target. On a hit, it takes 1d8 bludgeoning damage, and its speed is reduced by 10 feet until the start of your next turn.",
      "higherLevelScaling": "The spell’s damage increases by 1d8 when you reach 5th Level (2d8), 11th level (3d8), and 17th level (4d8).",
      "definitionStatus": "complete",
      "sourcePage": 196,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:unavailable:stoneshape",
      "name": "Stoneshape",
      "level": 4,
      "school": "Definition unavailable",
      "castingTime": "",
      "range": "",
      "components": [],
      "materialDetails": "",
      "duration": "",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "",
      "higherLevelScaling": "",
      "definitionStatus": "unavailable",
      "sourcePage": 178,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:stonga",
      "name": "Stonga (Stone III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "2d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate earth aspected aether to create 4 spears of stone anywhere you can see within range. The 4 spears travel in a straight line converging on a point within range. Any creature between the a stone spear and the convergence point must succeed on a Dexterity saving throw or take 2d6 Bludgeoning damage, taking half as much on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, you create one additional stone spear for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 196,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:stonja",
      "name": "Stonja (Stone IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "6d6",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate earth aspected aether cause the land in a 20ft. square to raise 20ft. into the air. You can select the speed of the ascension to change the effect of the spell. If you choose to raise the area slowly, creatures in the area are harmlessly raised to the platform’s height. If you choose to raise the area quickly, all creatures in the affected area must succeed on a Constitution saving throw or take 6d6 bludgeoning damage and be knocked prone, or take half as much damage and suffer no other effects on a success. You may maintain concentration to keep the platform raised, or return the ground to its original state afterwards.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the quick ascension deals an additional 2d6 bludegoning damage for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 197,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:stonra",
      "name": "Stonra (Stone II)",
      "level": 1,
      "school": "Transmutation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "3d8",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate earth aspected aether in the land at a location within range causing a cluster of stalagmites to burst upwards at the location. All creatures in a 5ft. radius circle must succeed on a Dexterity saving throw or take 3d8 bludgeoning damage and are knocked prone. On a success, an affected creature takes half the damage and is not knocked prone.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage dealt increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 196,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
