    {
      "id": "ffxiv-companion-dawntrail:demi-ultima",
      "name": "Demi Ultima",
      "level": 9,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "200 ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
