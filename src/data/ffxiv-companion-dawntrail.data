      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You release a barrage of raining bolts of energy in a 20ft. radius circle at a location within range. All creatures within the affected area succeed on a Dexterity saving throw or take 4d8 force damage, taking half as much on a success. On each of your turns until the spell ends, you can use your action to call down the barrage in this way again, targeting the same point or a different one.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage dealt increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 195,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
