    {
      "id": "ffxiv-companion-dawntrail:foul",
      "name": "Foul",
      "level": 8,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "4d10",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You tear a small hole in reality allowing the powers of the void to ravage a 40ft. radius sphere at a point you can see within range. All creatures within 40ft. of the location must succeed on a Charisma saving or take 4d10 necrotic damage and 4d10 force damage, and take half as much damage on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 9th level, the force damage increases by 3d10 for each slot level above 8th.",
      "definitionStatus": "complete",
      "sourcePage": 193,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:freeze",
      "name": "Freeze",
      "level": 7,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "5d6",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate ice aether to cause a flash freezing storm at a location you can see in a 40ft. radius sphere. All creatures in the area must make a Constitution saving throw, taking 5d6 cold damage and 5d6 force damage and become restrained until the end of their next turn on a failure or take half as much damage and not be restrained on a successful one. A creature may use their action to make a strength saving throw, losing the restrained condition on a success. All surfaces in the affected area becomes coated in slick ice for 1 minute or until melted. A creature traversing the slick ice at more than half speed is required to make a DC 15 Acrobatic check at the start of the movement. Failure causes the creature to fall prone at the start of the movement.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 8th level or higher, the force damage increases by 2d6 for each slot level above 7th.",
      "definitionStatus": "complete",
      "sourcePage": 193,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
