    {
      "id": "ffxiv-companion-dawntrail:banish",
      "name": "Banish",
      "level": 1,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Radiant",
      "damageFormula": "3d8",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "A flurry of small daggers of light converge on a creature you can see within range. The creature makes a dexterity saving throw, the creature taking 3d8 radiant damage on a failed save and half as much on a successful save.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 2nd.",
      "definitionStatus": "complete",
      "sourcePage": 185,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:banishga",
      "name": "Banishga (Banish III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "self.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Radiant",
      "damageFormula": "6d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate aether into blades of light which rain down on all hostile creatures in a 30ft. radius centered on yourself. Each creature must succeed on a Dexterity saving throw, taking 6d6 radiant damage on a failure and half as much on a success. If a creature is a Fiend or Undead, they take an additional 8 radiant damage. This damage is not reduced on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the damage increases by 1d6 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 185,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
