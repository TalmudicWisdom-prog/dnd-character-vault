      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You choose a creature you can see within range veil them with protective magics to protect them from one of the following damage types: bludgeoning, cold, fire, lightning, necrotic, radiant or thunder. When they are targeted with an attack that deals that kind of damage the attack is made with disadvantage, and any saving throws they make against spells that deal that kind of damage is made with advantage. Any damage they take of the chosen damage type is reduced by your spell casting abilitiy modifier.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, you may protect one additional creature for each slot level above 3rd or choose an additional element for one creature.",
      "definitionStatus": "complete",
      "sourcePage": 185,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
