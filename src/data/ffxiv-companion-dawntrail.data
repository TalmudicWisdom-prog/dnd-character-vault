    {
      "id": "ffxiv-companion-dawntrail:fira",
      "name": "Fira (Fire II)",
      "level": 1,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Fire",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You gather a small globe of unstable fire aether and launch it towards a target creature you can see within range. Make a ranged spell attack against the target. On a hit, the target takes 1d10 fire damage. Hit or miss, the globe then explodes. The target and each creature within 5 feet of it must succeed on a Dexterity saving throw or take 2d6 fire damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the secondary fire damage increases by 1d6 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 192,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:firaga",
      "name": "Firaga (Fire III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Fire",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You ignite the area around a target creature you can see within range. The target creature must succeed on a Dexterity saving throw or take 5d8 fire damage and also burns for the spell’s duration, or take half as much damage and are not burned on a successful one. At the start of the creature’s turn they are burned for 1d8 fire damage. At the end of each of its turns, the target repeats the saving throw, the spell ends on a successful one.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the burning fire damage increases by 1d6 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 192,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:firaja",
      "name": "Firaja (Fire IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Fire",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create a spherical cage of fire with a radius of 20ft. that instantly incinerates all those trapped inside at a location you can see within range. All creatures in the affected area must succeed on a Dexterity saving throw or take 4d8 fire damage, or take half as much damage on a successful one. The cage persists after the initial damage, as an action you can make all creatures inside the cage repeat the saving throw, dealing 3d8 fire damage on a failure and half as much on a success. A creature who leaves the cage by walking through the flames takes 4d8 fire damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the initial fire damage increases by 1d8 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 192,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:fire",
      "name": "Fire",
      "level": 0,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Fire",
      "damageFormula": "2d4",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You gather fire aspected aether into an orb and shoots it toward a creature within range. Make a ranged spell attack against the target. On a hit, it takes 2d4 fire damage. A flammable object hit by this spell ignites if it isn’t being worn or carried.",
      "higherLevelScaling": "The spell’s damage increases by 2d4 when you reach 5th Level (4d4), 11th level (6d4), and 17th level (8d4).",
      "definitionStatus": "complete",
      "sourcePage": 191,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
