    {
      "id": "ffxiv-companion-dawntrail:bio",
      "name": "Bio",
      "level": 0,
      "school": "Necromancy",
      "castingTime": "1 action",
      "range": "30 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Poison",
      "damageFormula": "1d4",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You attempt to infect the target creature they can see within range with the effects of a serious illness. The target must succeed on a Constitution saving throw or take 1d4 poison damage and become poisoned for 1 minute. A poisoned creature takes an additional 1d4 poison damage at the start of their turn and repeats the saving throw at the end of their turn, ending the poison effect on a success.",
      "higherLevelScaling": "This spell’s intial damage increases by 1d4 when you reach 5th level (2d4), 11th level (3d4), and 17th level (4d4).",
      "definitionStatus": "complete",
      "sourcePage": 186,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:bioga",
      "name": "Bioga (Bio III)",
      "level": 3,
      "school": "Necromancy",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Poison",
      "damageFormula": "6d4",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create a virulent outbreak in a 15ft. cube at a location you can see wtihin range. Each creature in the affected area must succeed on a Constitution saving throw or take 6d4 poison damage and become poisoned for up to 1 minute. On a success creatures take half as much much and suffer no other consequences. W hile you are concentrating on the spell, you may use your action to cause the disease to spread. Any creatures who have not been affected by the spell that are within 15ft. of an affected creature must succeed on the saving throw or they also take the damage and become poisoned as well. At the end of a poisoned creatuers turn they reattempt the saving throw, ending the poison on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the damage increases by 2d4 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 186,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:bioja",
      "name": "Bioja (Bio IV)",
      "level": 5,
      "school": "Necromancy",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "4d8",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "A blast of virulent air erupts from your hands. Each creature in a 60-foot cone must make a Constitution saving throw. A creature takes 4d8 poison damage and 4d8 necrotic damage and become poisoned for 1 minute on a failed save, or half as much damage on a successful one. At the end of a poisoned creature’s turn they reattempt the saving throw, ending the poison on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the initial necrotic damage increases by 2d8 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 186,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:biolysis",
      "name": "Biolysis",
      "level": 5,
      "school": "Necromancy",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Necrotic",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You attempt to make a creature you can see within range violently ill instantaneously. The creature must succeed on a Constitution saving throw or take 6d10 necrotic damage and become poisoned and on a success creatures take half as much much and suffer no other consequences. At the start of each of the affected creature’s turns, they take 1d10 necrotic damage and they must succeed on a Constitution saving throw or spend their action retching in pain. The affected creature reattempts the saving throw at the end of each of their turns, ending the spell effect on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the initial damage increases by 2d10 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 186,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
