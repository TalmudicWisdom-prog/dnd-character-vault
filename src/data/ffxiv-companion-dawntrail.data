    {
      "id": "ffxiv-companion-dawntrail:banishja",
      "name": "Banishja (Banish IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "Self (100 feet line)",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Radiant",
      "damageFormula": "8d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You select any number of creatures in a 15 feet wide, 100 feet long. line from you in a direction you choose and drop a spear of searing light on them. Each creature must make a Dexterity saving throw, taking 8d6 radiant damage on a failure and half as much on a success. If a creature is a Fiend or Undead, they take an additional 8 radiant damage. This damage is not reduced on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the damage increases by 2d6 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 185,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:banishra",
      "name": "Banishra (Banish II)",
      "level": 2,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
