    {
      "id": "ffxiv-companion-dawntrail:aero",
      "name": "Aero",
      "level": 0,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Thunder",
      "damageFormula": "1d8",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjure a burst of wind around a creature you can see within range. The target must succeed on a Dexterity saving throw or take 1d8 thunder damage. The target gains no benefit from cover for this saving throw.",
      "higherLevelScaling": "This spell’s damage increases by 1d8 when you reach 5th level (2d8), 11th level (3d8), and 17th level (4d8).",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:aeroga",
      "name": "Aeroga (Aero III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Thunder",
      "damageFormula": "5d8",
      "healingFormula": "",
      "savingThrowType": "STR",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate wind aether to create a savage burst of wind at a point you can see within range. The ravaging windstorm is a 20ft. radius sphere. All creatures in the area must succeed on a Strength saving throw or take 5d8 thunder damage and be knocked 20ft. straight backwards from the center point. On a success all creatures take half the damage and suffer no other effect.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the damage increases by 1d8 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:aeroja",
      "name": "Aeroja (Aero IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, Up to 1 minutes",
      "concentration": true,
      "ritual": false,
      "damageType": "",
      "damageFormula": "3d6",
      "healingFormula": "",
      "savingThrowType": "STR",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjure a swirling vortex of wind aether that tears at all creatures inside. The vortex forms in a 20-foot- radius, 40-foot-high cylinder centered on a point within range. When a creature enters the spell’s area for the first time on a turn or starts its turn there, they must succeed on a Strength saving throw or take 3d6 thunder damage plus 3d6 slashing damage, and half as much damage on a success. The area is affected by the vortex is considered difficult terrain. On each of your turns after you cast this spell, you can use a bonus action to move the vortex 60 feet in any direction.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the thunder damage increases by 2d6 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
