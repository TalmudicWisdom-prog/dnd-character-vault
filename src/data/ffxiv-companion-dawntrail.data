    {
      "id": "ffxiv-companion-dawntrail:assize",
      "name": "Assize",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "self.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Radiant",
      "damageFormula": "4d4",
      "healingFormula": "3d8",
      "savingThrowType": "WIS",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "An eruption of energy from your body soothes allies and wounds enemies. All allies within 60ft. recover 3d8 hit points and all enemies within 60ft. must make a wisdom saving throw. They take 4d4 radiant damage, and half as much on a successful save. You may reverse which die affect healing and which die deal radiant damage, but must make this distinction before rolling.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, increase the number of die for each effect for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:asylum",
      "name": "Asylum",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "concentration, 1 minute",
      "concentration": true,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "1d8",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create a protective field which provides healing to friendly creatures. You create a globe of holy energy with a radius of 30ft. within range. All allied creatures within the affected area recover 1d8 hit points at the start of their turn. Additionally, allied creatures within the affected creatures gain resistance to nonmagical slashing, piercing, and bludgeoning damage and necrotic damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, increase the heal by 1d8 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
