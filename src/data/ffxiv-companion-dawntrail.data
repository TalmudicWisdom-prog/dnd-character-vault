    {
      "id": "ffxiv-companion-dawntrail:bravery",
      "name": "Bravery",
      "level": 1,
      "school": "Transmutation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, 1 minute",
      "concentration": true,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You choose a creature you can see within range and fill them with vigor. W eapon attacks they made deal bonus damage equal to their proficiency bonus and is immune to being frightened.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, you may empower one creature for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 187,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:break",
      "name": "Break",
      "level": 1,
      "school": "Enchantment",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Force",
      "damageFormula": "3d4",
      "healingFormula": "",
      "savingThrowType": "CHA",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You cast a hex on a creature you can see within range. The creature must succeed on a Charisma saving throw, taking 3d4 force damage on a failure and their speed is reduced by 30ft. for 1 minute. The creature takes half the damage and suffers no additional effects on a success. At the end of the creature’s turn, they may reattempt the saving throw, removing the hex on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d4 for each slot level above 1st and you target an additional creature for each spell level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 187,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
