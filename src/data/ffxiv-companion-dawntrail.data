    },
    {
      "id": "ffxiv-companion-dawntrail:ruinja",
      "name": "Ruinja (Ruin IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
