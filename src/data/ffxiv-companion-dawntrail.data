    {
      "id": "ffxiv-companion-dawntrail:imperil",
      "name": "Imperil",
      "level": 7,
      "school": "Transmutation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Concentration, 1 minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Force",
      "damageFormula": "1d8",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You choose a creature you can see within range and and they must make a W isdom saving throw. On a failure, they gain a damage vulnerability to the following damage types: bludgeoning, cold, fire, lightning, necrotic, radiant and thunder. If the creature is immune to the damage type, it takes normal damage from the damage type instead. Jolt evocation cantrip Casting Time:1 action Range:60 feet Components:V, S Duration:Instantaneous A shard of crystallized aether streaks toward a creature within range. Make a ranged spell attack against the target. On a hit, the target takes 1d8 force damage.",
      "higherLevelScaling": "The spell creates more than one shard when you reach higher levels: two shards at 5th level, three shards at 11th level, and four shards at 17th level. You can direct the shards at the same target or at different ones. Make a separate attack roll for each shard.",
      "definitionStatus": "complete",
      "sourcePage": 193,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
