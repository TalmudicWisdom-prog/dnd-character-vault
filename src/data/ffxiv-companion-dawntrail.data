    {
      "id": "ffxiv-companion-dawntrail:flare",
      "name": "Flare",
      "level": 7,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "6d6",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create a massive, fiery explosion at a point you can see within range. All creatures within 40ft. of the location must succeed on a Dexterity saving or take 6d6 fire damage and 6d6 force damage, and take half as much damage on a success. If this damage reduces the target to 0 hit points, it is disintegrated. A disintegrated creature and everything it is wearing and carrying, except magic items, are reduced to a pile of fine gray dust. The creature can be restored to life only by means of a true resurrection or a wish spell. This spell automatically disintegrates a Large or smaller nonmagical object or a creation of magical force. If the target is a Huge or larger object or creation of force, this spell disintegrates a 10-foot-cube portion of it. A magic item is unaffected by this spell.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 8th level or higher, the force damage increases by 2d6 for each slot level above 7th.",
      "definitionStatus": "complete",
      "sourcePage": 192,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
