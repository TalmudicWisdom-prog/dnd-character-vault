    {
      "id": "ffxiv-companion-dawntrail:aerora",
      "name": "Aerora (Aero II)",
      "level": 1,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Thunder",
      "damageFormula": "3d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate wind aether to create a ragging vacuum at a point you can see within range. The vacuum is a 10ft. radius sphere that disperses gas or vapor, and it extinguishes candles, torches, and similar unprotected flames in the area. It causes protected flames, such as those of lanterns, to dance wildly and has a 50 percent chance to extinguish them. Any creatures in the area must succeed on a Dexterity saving throw or take 3d6 thunder damage or half as much on a successful save.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 2nd.",
      "definitionStatus": "complete",
      "sourcePage": 184,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
