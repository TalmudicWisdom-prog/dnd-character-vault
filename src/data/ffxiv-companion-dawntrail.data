    {
      "id": "ffxiv-companion-dawntrail:veraero",
      "name": "Veraero",
      "level": 1,
      "school": "Evocation",
      "castingTime": "1 bonus action",
      "range": "30ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You fill your spell casting focus with wind aspected aether and cause the area around a creature you can see within range to burst. The creature must succeed on a Dexterity saving throw or take 2d8 thunder damage. If the target creature has already taken damage during your turn, it take an additional 2d6 force damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 198,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:veraeroga",
      "name": "Veraeroga (Veraero III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "concentration, up to 1 minute",
      "concentration": true,
      "ritual": false,
      "damageType": "",
      "damageFormula": "2d4",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjure a swirling vortex of wind aether that slices creatures who enter the area. The vortex forms in a 10- foot-radius, 40-foot-high cylinder centered on a point you can see within range. The affected area becomes difficult terrain for the duration. When a creature enters the spell’s area for the first time on a turn or starts its turn there, they take 2d4 thunder damage and 2d4 slashing damage. When a creature moves within the area, it takes an additional 2d4 slashing damage for every 5 feet it travels.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the thunder damage from the creature’s first entry in the affect area increases by 2d4 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 198,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:verfire",
      "name": "Verfire",
      "level": 2,
      "school": "Evocation",
      "castingTime": "1 bonus action",
      "range": "30ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You fill your spell casting focus with fire aspected aether and let loose a streaking bolt of fire at a creature you can see within range. Make a ranged spell attack against the target. On a hit, the target takes 3d8 fire damage. If the target creature has already taken damage during your turn, it take an additional 2d6 force damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 198,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:verflare",
      "name": "Verflare",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 bonus action",
      "range": "30ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You recklessly manipulate aether and cause a localized explosion of fire aether in a 10ft. radius sphere at a location you can see within range. All creatures within the area must succeed on a Dexterity saving throw or take 4d8 fire damage. If any of the creatures have already taken damage this turn, it take an additional 2d8 force damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 199,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:verholy",
      "name": "Verholy",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 bonus action",
      "range": "30ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You hastily manipulate light aspected aether to cause an eruption of light beneath an enemy within range. All creatures in a cylinder with a radius of 10ft. and 30ft. high must succeed on a Dexterity saving throw or take 4d8 radiant damage. If any of the creatures have already taken damage this turn, they take an additional 2d8 force damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the damage increases by 1d8 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 199,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:verstone",
      "name": "Verstone",
      "level": 2,
      "school": "Evocation",
      "castingTime": "1 bonus action",
      "range": "30ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "1d12",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create two stone spears at two unoccupied locations within range. The spears then travel in a straight line toward a point within range. All creatures in the path of a stone spear must succeed on a Dexterity saving throw or take 1d12 bludgeoning damage. If a creature is at the destination of the stone spears, they attempt one Dexterity saving throw for all of the stone spears but take damage from all stone spears you created. They take half the damage on a successful saving throw.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 3rd level or higher, you create an additional spear for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 199,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:verthundaga",
      "name": "Verthundaga (Verthunder III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Lightning",
      "damageFormula": "6d8",
      "healingFormula": "",
      "savingThrowType": "CON",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You release a burst of lightning aspected aether at a location you can see within range, exploding in a fulminous 20ft. radius sphere. Each creature in the affected area must make a Constitution saving throw, taking taking 6d8 lightning damage on a failure and half as much on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the damage dealt by the explosion increases by 1d8 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 199,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
