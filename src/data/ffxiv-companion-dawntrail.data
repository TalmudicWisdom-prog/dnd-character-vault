      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You release a focused burst of water at a creature you can see within range. The target must succeed on a Strength saving throw or take 3d6 bludgeoning damage and fall prone or be pushed back 30ft (your choice). Instead of a creature, you can target an object that isn’t being worn or carried and that weighs no more than 200 pounds. The object is either knocked over or pushed up to 30 feet away from you.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 2nd level or higher, the damage increases by 1d8 for each slot level above 1st.",
      "definitionStatus": "complete",
      "sourcePage": 200,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:waterga",
      "name": "Waterga (Water III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "concentration, up to a minute",
      "concentration": true,
      "ritual": false,
      "damageType": "Cold",
      "damageFormula": "3d10",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create an aquatic prison around a large or smaller creature you can see within range. The target creature must succeed on a Dexterity saving throw or take 3d10 cold damage and be engulfed in a bubble which acts as a prison of water, taking half damage and suffering no other effects on a success. The engulfed creature can’t breathe, is restrained, and takes 3d10 cold damage at the start of each of their turns. An engulfed creature can try to escape by taking an action to attempt a Strength saving throw against your Spell save DC. On a success, the creature manages to pop the bubble, freeing itself.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the initial damage increases by 1d10 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 200,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:waterja",
      "name": "Waterja (Water IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Bludgeoning",
      "damageFormula": "6d8",
      "healingFormula": "",
      "savingThrowType": "STR",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjure a powerful geyser at a location you can see within range. The area is a 20ft. radius cylinder which stands 40ft. high. All creatures in the affected area must succeed on a Strength saving throw or take 6d8 bludgeoning damage and be thrown 20ft. straight back, from the closest edge of the geyser, and take half as much damage and suffer no other effects on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the damage increases by 1d8 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 200,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
