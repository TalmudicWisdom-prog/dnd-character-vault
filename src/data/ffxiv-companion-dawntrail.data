    {
      "id": "ffxiv-companion-dawntrail:tetragammaton",
      "name": "Tetragammaton",
      "level": 4,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "3d8",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You may cast this spell as an action or a reaction when a creature takes damage. A creature within range you can see is healed for 3d8 hit points instantaneously.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 5th level or higher, the hit points recovered increases by 1d8 for each slot level above 4th.",
      "definitionStatus": "complete",
      "sourcePage": 197,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:thundaga",
      "name": "Thundaga (Thunder III)",
      "level": 3,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Lightning",
      "damageFormula": "4d8",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You launch an unstable sphere of lightning aspected aether at a target of your choice you can see within range. Make a ranged spell attack. On a hit, the sphere deals 4d8 lightning damage. The sphere then explodes in a 10ft. radius sphere. All creatures in range must succeed on a Dexterity saving throw or take 4d8 lightning damage, and half as much on a success.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 4th level or higher, the damage dealt by the explosion increases by 1d8 for each slot level above 3rd.",
      "definitionStatus": "complete",
      "sourcePage": 197,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:thundaja",
      "name": "Thundaja (Thunder IV)",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "120 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Lightning",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You manipulate lightning aether to create a mass orb of electrical energy at a location you can see within range that hovers in place for the duration. Any creature hostile to you that moves to a space within 20 feet of the orb for the first time on a turn must succeed on a Dexterity saving throw. The creature takes 20 lightning damage on a failed save and half as much on a successful one. The orb vanishes when it has dealt a total of 80 damage.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the maximum total damage of the orb increases by 20 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 198,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:thundara",
      "name": "Thundara (Thunder II)",
      "level": 1,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Lightning",
      "damageFormula": "2d8",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You launch of bolt of lightning aspected aether at a target of your choice you can see within range. Three bolts then leap from that target to as many as three other targets, each of which must be within 30 feet of the first target. A target can be a creature or an object and can be targeted by only one of the bolts. A target must make a Dexterity saving throw. The target takes 2d8 lightning damage on a failed save, or half as much damage on a successful one.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 3rd level or higher, one additional bolt leaps from the first target to another target for each slot level above 2nd.",
      "definitionStatus": "complete",
      "sourcePage": 197,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:thunder",
      "name": "Thunder",
      "level": 0,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "60 feet",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Lightning",
      "damageFormula": "2d6",
      "healingFormula": "",
      "savingThrowType": "",
      "attackRollRequired": true,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You conjures a mote of lightning aether and shoots it toward a creature within range. Make a ranged spell attack against the target. On a hit, it takes 2d6 lightning damage.",
      "higherLevelScaling": "The spell’s damage increases by 1d6 when you reach 5th Level (3d6), 11th level (4d6), and 17th level (5d6).",
      "definitionStatus": "complete",
      "sourcePage": 197,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
