      "damageFormula": "40d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You let loose an incredible burst of aether in a 60ft. radius sphere you can see within range. All creatures in the area must succeed on a Dexterity saving throw or take 40d6 force damage or half as much on a successful save. If this damage reduces the target to 0 hit points, it is disintegrated. A disintegrated creature and everything it is wearing and carrying, except magic items, are reduced to a pile of fine gray dust. The creature can be restored to life only by means of a true resurrection or a wish spell. This spell automatically disintegrates a Large or smaller nonmagical object or a creation of magical force. If the target is a Huge or larger object or creation of force, this spell disintegrates a 10-foot-cube portion of it. A magic item is unaffected by this spell.",
      "higherLevelScaling": "",
      "definitionStatus": "complete",
      "sourcePage": 190,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
