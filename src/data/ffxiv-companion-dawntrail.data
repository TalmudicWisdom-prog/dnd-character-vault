    {
      "id": "ffxiv-companion-dawntrail:collective-unconscious",
      "name": "Collective Unconscious",
      "level": 5,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "Self",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "concentration, 1 minute",
      "concentration": true,
      "ritual": false,
      "damageType": "",
      "damageFormula": "",
      "healingFormula": "1d6",
      "savingThrowType": "",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You create a magical barrier around yourself. The barrier is 30ft. in radius and spherical. All allies within 10ft. of you are healed immediately for 3d8. As long as they remain in the barrier, their AC receives a +1 bonus and each time they start their turn within the barrier they are healed for 1d6 hit points.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 6th level or higher, the heal increases by 1d6 for each slot level above 5th.",
      "definitionStatus": "complete",
      "sourcePage": 188,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:comet",
      "name": "Comet",
      "level": 4,
      "school": "Conjuration",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Force",
      "damageFormula": "3d6",
      "healingFormula": "",
      "savingThrowType": "DEX",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You concentrate three large shards of pure aether and direct them to crash down at locations you can see within range. The shards of aether explode in a 20ft. radius explosion. Each creature in an affected area must make a Dexterity saving throw taking 3d6 force damage on a failure, or half as much on a success. A creature who is hit by multiple comets makes this saving throw once, but does take damage from each comet explosion’s affected area.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 5th level or higher, an additional comet is created.",
      "definitionStatus": "complete",
      "sourcePage": 188,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
