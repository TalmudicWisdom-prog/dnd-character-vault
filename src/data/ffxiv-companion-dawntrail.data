    {
      "id": "ffxiv-companion-dawntrail:celestial-opposition",
      "name": "Celestial Opposition",
      "level": 8,
      "school": "Evocation",
      "castingTime": "1 action",
      "range": "Self",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Force",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "WIS",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You release a massive amount of astral energy in a 30ft. radius globe centered on you. The inside of the globe is dimly lit, and filled with softly glowing lights which map the starry sky. On this release, all enemies coming in contact with the sphere are star struck and must make a wisdom saving throw. Enemies take 6d8 force damage and are stunned for 1d4 rounds on a failed saved, and half the damage is taken and they resist becoming stunned on a success.",
      "higherLevelScaling": "",
      "definitionStatus": "complete",
      "sourcePage": 188,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
