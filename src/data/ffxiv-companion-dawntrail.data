    {
      "id": "ffxiv-companion-dawntrail:flood",
      "name": "Flood",
      "level": 7,
      "school": "Conjuration",
      "castingTime": "1 action",
      "range": "120ft.",
      "components": [
        "V",
        "S"
      ],
      "materialDetails": "",
      "duration": "Instantaneous",
      "concentration": false,
      "ritual": false,
      "damageType": "Force",
      "damageFormula": "",
      "healingFormula": "",
      "savingThrowType": "STR",
      "attackRollRequired": false,
      "areaOfEffectType": "",
      "areaOfEffectSize": "",
      "statusEffects": "",
      "description": "You select a point you can see within range and cause an instantaneous flood to burst through a 40ft. radius sphere around the point. Each creature in the affected area must make a Strength saving throw, taking 4d6 cold, 4d6 bludgeoning and 2d6 force damage and are knocked back 40ft. from the point of the flood, or half as much damage and are knocked back 10ft. on a successful one.",
      "higherLevelScaling": "When you cast this spell using a spell slot of 8th level or higher, the force damage increases by 2d6 for each slot level above 7th.",
      "definitionStatus": "complete",
      "sourcePage": 192,
      "rulesSourceId": "ffxiv-companion-dawntrail",
      "sourceVersion": "2025-02-18",
      "homebrew": true
    },
