      "homebrew": true
    },
    {
      "id": "ffxiv-companion-dawntrail:bar-element",
      "name": "Bar-Element",
      "level": 4,
      "school": "Abjuration",
      "castingTime": "1 action",
      "range": "60ft.",
      "components": [
        "V",
        "S"
      ],
